#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,0
PRODUCTVERSION  @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Enables VScript HTTP for every Dota 2 custom game"
            VALUE "FileVersion",      "@APP_VERSION@"
            VALUE "InternalName",     "dota-enable-http"
            VALUE "OriginalFilename", "dota-enable-http.exe"
            VALUE "ProductName",      "dota-enable-http"
            VALUE "ProductVersion",   "@APP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
